---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description, page } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#46338E">
  <link rel="icon" href="/assets/favicon.png">
</head>
<body data-page={page}>
  <a class="skip" href="#content">Skip to content</a>
  <noscript><p class="noscript">Turn on JavaScript to load the menu and live NAD prices.</p></noscript>
  <Header />
  <slot />
  <Footer />
  <script is:inline src="/js/data.js"></script>
  <script is:inline src="/js/main.js"></script>
</body>
</html>
